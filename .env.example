# Run `npm run setup` to generate local credentials automatically.
# For Vercel, set these as Environment Variables in your project settings.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
